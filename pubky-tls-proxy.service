# https://github.com/pubky/pubky-tls-proxy/blob/master/pubky-tls-proxy.service
[Unit]
Description=pubky-tls-proxy - TLS terminating proxy for raw public key TLS RFC 7250 which is used in Pubky
After=network-online.target

[Service]
# Update the binary path and the config file. See the README for the config file format.
# A relative secret_file in the config file is resolved against the config file's directory.
#
# Without a config file, pass the settings as arguments instead, e.g. to forward to a
# Pubky homeserver directly (which doesn't understand the PROXY protocol):
# ExecStart=/usr/local/bin/pubky-tls-proxy --secret-file=/etc/pubky-tls-proxy/secret --listen-addr=0.0.0.0:8443 --http-backend-addr=127.0.0.1:6286 --no-proxy-protocol
ExecStart=/usr/local/bin/pubky-tls-proxy --config=/etc/pubky-tls-proxy/config.toml
Environment="RUST_BACKTRACE=full"
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target